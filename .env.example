# ==============================================================================
# Environment Configuration Template
# System and Methods of Intelligent Disaster Assistance and Community Safety
# Copy this file to .env and populate with local development secrets.
# NEVER commit .env to version control!
# ==============================================================================

# General
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage & Processing Limits
STORAGE_DIR=results
MAX_UPLOAD_MB=200
MAX_PIXELS=25000000

# Model Configuration
MODEL_MODE=real
MODEL_DEVICE=cpu
FLOOD_PREDICTOR=flood.predict
LANDSLIDE_PREDICTOR=landslide.predict
FLOOD_CHECKPOINT_PATH=
LANDSLIDE_CHECKPOINT_PATH=

# Database (PostgreSQL + PostGIS)
POSTGRES_USER=disaster_user
POSTGRES_PASSWORD=disaster_password_change_me
POSTGRES_DB=disaster_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
TEST_DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/disaster_test_db

# Geospatial & Satellite Data Storage / Remote DVC Storage
# Optional: S3 / GCS / Local remote storage for DVC
DVC_REMOTE_URL=
DVC_REMOTE_USER=
DVC_REMOTE_PASSWORD=

# External Geospatial APIs & Tokens (if required)
# Copernicus Open Access Hub / Sentinel Hub
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# NASA Earthdata (for SRTM DEM, GPM IMERG)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
