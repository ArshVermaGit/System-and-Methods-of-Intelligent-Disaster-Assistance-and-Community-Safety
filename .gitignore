# Data directory contents (DVC managed)
# Allow git to track the data directories and .dvc pointer files
/data/raw/**
/data/interim/**
/data/processed/**
!/data/**/
!/data/**/.gitkeep
!/data/**/.gitignore
!/data/**/*.dvc

# DVC local storage
.dvc/cache
.dvc/tmp
.dvc/*.local

